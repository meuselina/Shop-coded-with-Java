    private void zeigeKategorie(String kategorie) {
        jList2Model.clear();
        LinkedList<?> items = null;

        if (kategorie.equalsIgnoreCase("oberteile")) {
            items = shop.getoberteile();
        } if (kategorie.equalsIgnoreCase("hosen")) {
            items = shop.getHosen();
        }  if (kategorie.equalsIgnoreCase("accessoires")) {
            items = shop.getAccessoires();
        }  if (kategorie.equalsIgnoreCase("tracksuits")) {
            items = shop.getTracksuits();
        } if (kategorie.equalsIgnoreCase("schuhe")) {
            items = shop.getSchuhe();
        }

        if (items != null) {
            for (Object item : items) {
                try {
                    String art = (String) item.getClass().getMethod("getArt").invoke(item);
                    jList2Model.addElement(art);
                } catch (Exception e) {
                    e.printStackTrace();
                }
            }
        } else {
            jList2Model.addElement("Kategorie nicht verfügbar.");
        }
    }

